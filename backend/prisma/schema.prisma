generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
  SHIPPING
}

enum OrderStatus {
  DRAFT
  PARTIALLY_PAID
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum OrderPaymentMethod {
  WIRE_TRANSFER
  CREDIT_CARD
  INVOICE
  OTHER
}

enum ShipmentStatus {
  PENDING
  LOCATING
  PRE_PROCESSING
  PURCHASE
  SHIPPED
  IN_TRANSIT
  DISPUTED
  DELIVERED
  DELAYED
  CANCELLED
}

enum ReplacementStatus {
  WAITING_YARD_RESPONSE
  YARD_CONTACTED
  AGREED
  DISAGREED
  YARD_REFUNDING
  YARD_DOESNT_HAVE_REPLACEMENT
  SHIPPED
  IN_TRANSIT
  DELIVERED
}

enum NoteEntityType {
  ORDER
  SHIPMENT
  LEAD
  WEBSITE_LEAD
}

enum WebsiteLeadStatus {
  NEW
  CONTACTED
  CLOSED
  CONVERTED
}

enum LeadStatus {
  PROSPECT
  QUOTED
  CALL_BACK_LATER
  SHOPPING_AROUND
  NOT_INTERESTED
  NEEDS_LOCALLY
  WE_DONT_SALE
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(160)
  passwordHash String   @db.VarChar(255)
  role         Role     @default(SALES)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

    leads  Lead[]
    assignedWebsiteLeads WebsiteLead[] @relation("WebsiteLeadAssignee")
    convertedWebsiteLeads WebsiteLead[] @relation("WebsiteLeadConverter")
    orders Order[]
    notes  Note[]
    notifications Notification[]
    shipmentAdditionalCosts ShipmentAdditionalCost[]
    shipmentCostHistories ShipmentCostHistory[]
    replacementRequestsCreated ReplacementRequest[] @relation("ReplacementRequestCreatedBy")
    replacementRequestsUpdated ReplacementRequest[] @relation("ReplacementRequestUpdatedBy")
    replacementHistories ReplacementHistory[]
    releaseAcknowledgements ReleaseAcknowledgement[]
    reminderPreferences ReminderUserPreference?
    remindersOwned Reminder[] @relation("ReminderOwner")
    remindersCreated Reminder[] @relation("ReminderCreator")
    remindersCompleted Reminder[] @relation("ReminderCompleter")
    remindersWorking Reminder[] @relation("ReminderWorker")
    reminderHistory ReminderHistory[]
    reminderDeliveries ReminderDelivery[]
    reminderPushSubscriptions ReminderPushSubscription[]
    reminderDigests ReminderDigest[]
    reminderSeriesCreated ReminderSeries[]
    reminderSuggestionDecisions ReminderSuggestion[]
    reminderAutomationAudits ReminderAutomationAudit[]
}

model ReleaseAcknowledgement {
  userId    String   @db.Uuid
  releaseId String   @db.VarChar(40)
  seenAt    DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, releaseId])
}

model Lead {
  id               String    @id @default(uuid()) @db.Uuid
  leadDate         DateTime
  adviserName      String    @db.VarChar(120)
  cmpt             String    @db.VarChar(80)
  customerPhone    String    @db.VarChar(30)
  customerName     String    @db.VarChar(160)
  customerEmail    String?   @db.VarChar(160)
  state            String?   @db.VarChar(80)
  partDescription  String    @db.VarChar(255)
  vehicleYear      String?   @db.VarChar(10)
  vehicleMake      String?   @db.VarChar(80)
  vehicleModel     String?   @db.VarChar(80)
  vehicleVariant   String?   @db.VarChar(80)
  quote            Decimal?  @db.Decimal(12, 2)
  quoteCurrency    String    @default("USD") @db.VarChar(3)
  comments         String?   @db.Text
  prospects        String    @db.VarChar(255)
  status           LeadStatus @default(PROSPECT)
  createdById      String    @db.Uuid
  convertedOrderId String?   @unique @db.Uuid
  convertedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  createdBy      User   @relation(fields: [createdById], references: [id], onDelete: Restrict)
  convertedOrder Order? @relation("ConvertedLeadOrder", fields: [convertedOrderId], references: [id], onDelete: SetNull)
  notes          Note[]
  websiteLead    WebsiteLead? @relation("WebsiteLeadConversion")
  reminders Reminder[]

  @@index([leadDate])
  @@index([createdById])
  @@index([status])
  @@index([convertedAt])
}

model WebsiteLead {
  id                   String            @id @default(uuid()) @db.Uuid
  source               String            @db.VarChar(60)
  sourceFormId         String            @db.VarChar(80)
  sourcePageUrl        String?           @db.VarChar(1000)
  externalSubmissionId String            @db.VarChar(120)
  submittedAt          DateTime
  customerName         String?           @db.VarChar(160)
  customerPhone        String?           @db.VarChar(50)
  customerEmail        String?           @db.VarChar(160)
  state                String?           @db.VarChar(80)
  zipCode              String?           @db.VarChar(20)
  vehicleYear          String?           @db.VarChar(10)
  vehicleMake          String?           @db.VarChar(80)
  vehicleModel         String?           @db.VarChar(80)
  vin                  String?           @db.VarChar(40)
  partRequested        String?           @db.VarChar(255)
  message              String?           @db.Text
  smsOptIn             Boolean?
  status               WebsiteLeadStatus @default(NEW)
  assignedToId         String?           @db.Uuid
  convertedLeadId      String?           @unique @db.Uuid
  convertedById        String?           @db.Uuid
  convertedAt          DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  assignedTo    User?  @relation("WebsiteLeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  convertedBy   User?  @relation("WebsiteLeadConverter", fields: [convertedById], references: [id], onDelete: SetNull)
  convertedLead Lead?  @relation("WebsiteLeadConversion", fields: [convertedLeadId], references: [id], onDelete: Restrict)
  notes         Note[]
  reminders Reminder[]

  @@unique([source, externalSubmissionId])
  @@index([status, submittedAt])
  @@index([assignedToId, submittedAt])
  @@index([submittedAt])
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  orderNumber     String      @unique @db.VarChar(50)
  salesNumber     String?     @db.VarChar(80)
  customerName    String      @db.VarChar(160)
  partDescription String      @db.VarChar(255)
  customerEmail   String?     @db.VarChar(160)
  customerPhone   String?     @db.VarChar(30)
  intakeDetails   Json?
  billingState    String? @db.VarChar(2)
  price           Decimal     @db.Decimal(12, 2)
  quantity        Int
  totalSaleAmount Decimal     @db.Decimal(12, 2)
  currency        String      @default("USD") @db.VarChar(3)
  status          OrderStatus @default(DRAFT)
  paymentMethod   OrderPaymentMethod?
  createdById     String      @db.Uuid
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  createdBy User       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  sourceLead Lead?     @relation("ConvertedLeadOrder")
  shipments Shipment[]
  notes     Note[]
  invoice   Invoice?
  replacementRequests ReplacementRequest[]
  reminders Reminder[]

  @@index([orderNumber])
  @@index([createdById])
}

model Invoice {
  id                     String    @id @default(uuid()) @db.Uuid
  orderId                String    @unique @db.Uuid
  invoiceNumber          String    @unique @db.VarChar(50)
  invoiceDate            DateTime
  salesAssistant         String?   @db.VarChar(120)
  customerName           String    @db.VarChar(160)
  contactNumber          String?   @db.VarChar(30)
  billingAddress         String?   @db.Text
  shippingAddress        String?   @db.Text
  shippingVendor         String    @default("LTL") @db.VarChar(80)
  deliveryTimeline       String    @default("9-14 Business Days") @db.VarChar(120)
  itemDescription        String    @db.VarChar(255)
  vehiclePartDescription String?   @db.VarChar(255)
  warrantyPartsOnly      String?   @db.Text
  cancellationPolicy     String?   @db.Text
  quantity               Int
  saleAmount             Decimal   @db.Decimal(12, 2)
  paymentStatus          String?   @db.VarChar(80)
  paymentDate            DateTime?
  paymentSource          String?   @db.VarChar(160)
  shippingCost           Decimal   @default(0) @db.Decimal(12, 2)
  salesTaxes             Decimal   @default(0) @db.Decimal(12, 2)
  coreCharge             Decimal   @default(0) @db.Decimal(12, 2)
  totalAmount            Decimal   @db.Decimal(12, 2)
  customerSignature      String?   @db.Text
  customerSignatureImage String?   @db.Text
  signatureDate          DateTime?
  photoIdRequired        Boolean   @default(false)
  photoIdDocument        String?   @db.Text
  photoIdFileName        String?   @db.VarChar(255)
  photoIdMimeType        String?   @db.VarChar(80)
  photoIdUploadedAt      DateTime?
  signedAt               DateTime?
  signatureIpAddress     String?   @db.VarChar(64)
  signatureTokenHash     String?   @unique @db.VarChar(128)
  signatureTokenExpiresAt DateTime?
  signatureRequestedAt   DateTime?
  signatureLastSentAt    DateTime?
  status                 String    @default("CREATED") @db.VarChar(40)
  pdfStorageKey          String?   @db.VarChar(255)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  auditEvents InvoiceAuditEvent[]

  @@index([invoiceNumber])
  @@index([createdAt])
  @@index([signatureTokenExpiresAt])
}

model InvoiceAuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @db.Uuid
  eventType   String   @db.VarChar(40)
  title       String   @db.VarChar(80)
  description String   @db.Text
  actorName   String?  @db.VarChar(160)
  actorEmail  String?  @db.VarChar(160)
  actorPhone  String?  @db.VarChar(40)
  ipAddress   String?  @db.VarChar(64)
  metadata    Json?
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, occurredAt])
  @@index([eventType])
}

model Shipment {
  id          String         @id @default(uuid()) @db.Uuid
  bolNumber   String?        @unique @db.VarChar(50)
  pickupNumber String?        @db.VarChar(50)
  proNumber   String?        @unique @db.VarChar(50)
  carrierName String?        @db.VarChar(120)
  status      ShipmentStatus @default(PENDING)
  orderId     String         @db.Uuid
  shippedAt   DateTime?
  deliveredAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

    order   Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
    costs   ShipmentCost[]
    additionalCosts ShipmentAdditionalCost[]
    costHistories ShipmentCostHistory[]
    events  ShipmentEvent[]
    notes   Note[]
    replacementRequests ReplacementRequest[]
    reminders Reminder[]

  @@index([bolNumber])
  @@index([pickupNumber])
  @@index([proNumber])
  @@index([orderId])
}

model ReplacementRequest {
  id                String            @id @default(uuid()) @db.Uuid
  orderId           String            @db.Uuid
  shipmentId        String?           @db.Uuid
  customerReason    String            @db.Text
  yardUpdate        String?           @db.Text
  replacementStatus ReplacementStatus @default(WAITING_YARD_RESPONSE)
  replacementProNumber String?         @db.VarChar(50)
  replacementCarrierName String?       @db.VarChar(120)
  createdById       String            @db.Uuid
  updatedById       String?           @db.Uuid
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shipment  Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  createdBy User      @relation("ReplacementRequestCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User?     @relation("ReplacementRequestUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  histories ReplacementHistory[]
  reminders Reminder[]

  @@index([orderId])
  @@index([shipmentId])
  @@index([replacementStatus])
  @@index([replacementProNumber])
  @@index([updatedAt])
  @@index([createdAt])
}

model ReplacementHistory {
  id                   String   @id @default(uuid()) @db.Uuid
  replacementRequestId String   @db.Uuid
  action               String   @db.VarChar(80)
  summary              String   @db.Text
  previousStatus       ReplacementStatus?
  nextStatus           ReplacementStatus?
  customerReason       String?  @db.Text
  yardUpdate           String?  @db.Text
  replacementProNumber String?  @db.VarChar(50)
  replacementCarrierName String? @db.VarChar(120)
  createdById          String   @db.Uuid
  createdAt            DateTime @default(now())

  replacementRequest ReplacementRequest @relation(fields: [replacementRequestId], references: [id], onDelete: Cascade)
  createdBy          User               @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([replacementRequestId])
  @@index([createdById])
  @@index([createdAt])
}

  model ShipmentCost {
  id               String   @id @default(uuid()) @db.Uuid
  shipmentId       String   @unique @db.Uuid
  purchaseAmount   Decimal  @db.Decimal(12, 2)
  shippingAmount   Decimal  @default(0) @db.Decimal(12, 2)
  estimatedPurchaseAmount Decimal @default(0) @db.Decimal(12, 2)
  estimatedShippingAmount Decimal @default(0) @db.Decimal(12, 2)
  hasActualPurchaseAmount Boolean  @default(false)
  hasActualShippingAmount Boolean  @default(false)
  additionalAmount Decimal  @default(0) @db.Decimal(12, 2)
  grossProfit      Decimal  @db.Decimal(12, 2)
  currency         String   @default("USD") @db.VarChar(10)
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

    @@index([shipmentId])
  }

  model ShipmentAdditionalCost {
    id          String   @id @default(uuid()) @db.Uuid
    shipmentId  String   @db.Uuid
    amount      Decimal  @db.Decimal(12, 2)
    reason      String   @db.Text
    createdById String   @db.Uuid
    createdAt   DateTime @default(now())

    shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
    createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

    @@index([shipmentId])
    @@index([createdById])
    @@index([createdAt])
  }

  model ShipmentCostHistory {
    id          String   @id @default(uuid()) @db.Uuid
    shipmentId  String   @db.Uuid
    action      String   @db.VarChar(80)
    summary     String   @db.Text
    changes     Json?
    createdById String   @db.Uuid
    createdAt   DateTime @default(now())

    shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
    createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

    @@index([shipmentId])
    @@index([createdById])
    @@index([createdAt])
  }

model ShipmentEvent {
  id          String   @id @default(uuid()) @db.Uuid
  shipmentId  String   @db.Uuid
  eventType   String   @db.VarChar(80)
  description String?  @db.Text
  location    String?  @db.VarChar(160)
  eventAt     DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  @@index([shipmentId])
  @@index([eventAt])
}

model Note {
  id         String         @id @default(uuid()) @db.Uuid
  content    String         @db.Text
  entityType NoteEntityType
  authorId   String         @db.Uuid
  orderId    String?        @db.Uuid
  shipmentId String?        @db.Uuid
  leadId     String?        @db.Uuid
    websiteLeadId String?     @db.Uuid
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  author   User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  order    Order?    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: Restrict)
    websiteLead WebsiteLead? @relation(fields: [websiteLeadId], references: [id], onDelete: Restrict)

  @@index([authorId])
  @@index([orderId])
  @@index([shipmentId])
  @@index([leadId])
  @@index([websiteLeadId])
  @@index([entityType, orderId])
  @@index([entityType, shipmentId])
  @@index([entityType, leadId])
}

model Notification {
  id              String    @id @default(uuid()) @db.Uuid
  recipientUserId String    @db.Uuid
  type            String    @db.VarChar(80)
  title           String    @db.VarChar(160)
  message         String    @db.Text
  entityType      String    @db.VarChar(40)
  entityId        String    @db.Uuid
  isRead          Boolean   @default(false)
  readAt          DateTime?
  clearedAt       DateTime?
  createdAt       DateTime  @default(now())
  reminderId      String? @db.Uuid
  reminderDeliveryId String? @unique @db.Uuid
  reminder Reminder? @relation(fields: [reminderId], references: [id], onDelete: Restrict)

  recipient User @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, clearedAt, createdAt])
  @@index([recipientUserId, isRead, clearedAt])
  @@index([entityType, entityId])
}

enum ReminderContext {
  PERSONAL
  WEBSITE_LEAD
  LEAD
  ORDER
  SHIPMENT_ORDER
  SHIPMENT
  REPLACEMENT
}

enum ReminderOwnerKind {
  USER
  SHIPPING_QUEUE
}

enum ReminderStatus {
  OPEN
  SNOOZED
  COMPLETED
  CANCELLED
}

enum ReminderPriority {
  LOW
  MEDIUM
  HIGH
}

enum ReminderHistoryAction {
  CREATED
  EDITED
  SNOOZED
  WORK_STARTED
  HANDED_OFF
  REASSIGNED
  ESCALATED
  COMPLETED
  CANCELLED
  DELETED
}

enum ReminderDeliveryKind {
  EARLY
  DUE
  SECOND_ALERT
  ESCALATION
  ASSIGNED
  COMPLETED
  AUTO_CLOSED
  REASSIGNED
}

enum ReminderDeliveryChannel {
  BELL
  PUSH
  EMAIL
}

enum ReminderDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  CANCELLED
  FAILED
}

model ReminderType {
  key String @id @db.VarChar(50)
  label String @db.VarChar(80)
  allowedRoles Role[]
  isActive Boolean @default(true)
  reminders Reminder[]
  suggestionRules ReminderSuggestionRule[]
}

model Reminder {
  id String @id @default(uuid()) @db.Uuid
  title String @db.VarChar(120)
  typeKey String @db.VarChar(50)
  context ReminderContext
  originContext ReminderContext?
  originRecordId String? @db.Uuid
  websiteLeadId String? @db.Uuid
  leadId String? @db.Uuid
  orderId String? @db.Uuid
  shipmentId String? @db.Uuid
  replacementId String? @db.Uuid
  ownerKind ReminderOwnerKind
  ownerUserId String? @db.Uuid
  createdById String @db.Uuid
  assignedByAdmin Boolean @default(false)
  isHandoff Boolean @default(false)
  notifyCreatorOnCompletion Boolean @default(false)
  priority ReminderPriority @default(MEDIUM)
  note String? @db.VarChar(1000)
  dueAt DateTime @db.Timestamptz(3)
  localDueAt String @db.VarChar(16)
  timeZone String @db.VarChar(40)
  earlyAlertMinutes Int @default(0)
  status ReminderStatus @default(OPEN)
  snoozedUntil DateTime? @db.Timestamptz(3)
  snoozeCount Int @default(0)
  completedAt DateTime? @db.Timestamptz(3)
  completedById String? @db.Uuid
  completionNote String? @db.VarChar(1000)
  cancelReason String? @db.VarChar(255)
  escalatedAt DateTime? @db.Timestamptz(3)
  workingById String? @db.Uuid
  workingUntil DateTime? @db.Timestamptz(3)
  version Int @default(1)
  scheduleVersion Int @default(1)
  seriesId String? @db.Uuid
  occurrenceNumber Int?
  deletedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  type ReminderType @relation(fields: [typeKey], references: [key], onDelete: Restrict)
  websiteLead WebsiteLead? @relation(fields: [websiteLeadId], references: [id], onDelete: Restrict)
  lead Lead? @relation(fields: [leadId], references: [id], onDelete: Restrict)
  order Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  replacement ReplacementRequest? @relation(fields: [replacementId], references: [id], onDelete: Restrict)
  owner User? @relation("ReminderOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  createdBy User @relation("ReminderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  completedBy User? @relation("ReminderCompleter", fields: [completedById], references: [id], onDelete: Restrict)
  workingBy User? @relation("ReminderWorker", fields: [workingById], references: [id], onDelete: Restrict)
  histories ReminderHistory[]
  deliveries ReminderDelivery[]
  notifications Notification[]
  series ReminderSeries? @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  acceptedSuggestion ReminderSuggestion?
  @@unique([seriesId, occurrenceNumber])

  @@index([ownerUserId, deletedAt, status, dueAt])
  @@index([ownerKind, deletedAt, status, dueAt])
  @@index([status, dueAt])
  @@index([workingUntil])
  @@index([websiteLeadId, deletedAt, status, dueAt])
  @@index([leadId, deletedAt, status, dueAt])
  @@index([orderId, deletedAt, status, dueAt])
  @@index([shipmentId])
  @@index([replacementId])
  @@index([originContext, originRecordId])
  @@index([createdById])
}

enum ReminderRepeatFrequency {
  DAILY
  EVERY_N_DAYS
  WEEKLY
}
enum ReminderSuggestionStatus {
  PENDING
  ACCEPTED
  DISMISSED
  SUPERSEDED
}
model ReminderSeries {
  id String @id @default(uuid()) @db.Uuid
  frequency ReminderRepeatFrequency
  intervalDays Int @default(1)
  weekday Int?
  anchorLocalAt String @db.VarChar(16)
  lastScheduledLocalAt String @db.VarChar(16)
  template Json
  timeZone String @db.VarChar(40)
  untilDate String? @db.VarChar(10)
  maxOccurrences Int?
  stopStatus String? @db.VarChar(40)
  completedCount Int @default(0)
  version Int @default(1)
  isActive Boolean @default(true)
  stoppedAt DateTime? @db.Timestamptz(3)
  stopReason String? @db.VarChar(255)
  createdById String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  occurrences Reminder[]
}
model ReminderSuggestionRule {
  key String @id @db.VarChar(80)
  context ReminderContext
  trigger String @db.VarChar(50)
  label String @db.VarChar(120)
  typeKey String @db.VarChar(50)
  assignment String @default("RECORD_OWNER") @db.VarChar(30)
  delayDays Int @default(0)
  delayMinutes Int @default(60)
  requiresTime Boolean @default(false)
  missingCostOnly Boolean @default(false)
  repeatDays Int?
  stopStatus String? @db.VarChar(40)
  isActive Boolean @default(true)
  version Int @default(1)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  type ReminderType @relation(fields: [typeKey], references: [key], onDelete: Restrict)
  suggestions ReminderSuggestion[]
  @@index([context, trigger, isActive])
}
model ReminderSuggestion {
  id String @id @default(uuid()) @db.Uuid
  ruleKey String @db.VarChar(80)
  eventId String @db.Uuid
  context ReminderContext
  recordId String @db.Uuid
  trigger String @db.VarChar(50)
  status ReminderSuggestionStatus @default(PENDING)
  version Int @default(1)
  decidedById String? @db.Uuid
  decidedAt DateTime? @db.Timestamptz(3)
  acceptedReminderId String? @unique @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
