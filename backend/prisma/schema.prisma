generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
  SHIPPING
}

enum OrderStatus {
  DRAFT
  PARTIALLY_PAID
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum OrderPaymentMethod {
  WIRE_TRANSFER
  CREDIT_CARD
  INVOICE
  OTHER
}

enum ShipmentStatus {
  PENDING
  LOCATING
  PRE_PROCESSING
  PURCHASE
  SHIPPED
  IN_TRANSIT
  DISPUTED
  DELIVERED
  DELAYED
  CANCELLED
}

enum ReplacementStatus {
  YARD_CONTACTED
  WAITING_YARD_RESPONSE
  APPROVED
  SHIPPED
  IN_TRANSIT
  DELIVERED
}

enum NoteEntityType {
  ORDER
  SHIPMENT
}

enum LeadStatus {
  PROSPECT
  QUOTED
  CALL_BACK_LATER
  SHOPPING_AROUND
  NOT_INTERESTED
  NEEDS_LOCALLY
  WE_DONT_SALE
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(160)
  passwordHash String   @db.VarChar(255)
  role         Role     @default(SALES)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

    leads  Lead[]
    orders Order[]
    notes  Note[]
    notifications Notification[]
    shipmentAdditionalCosts ShipmentAdditionalCost[]
    shipmentCostHistories ShipmentCostHistory[]
    replacementRequestsCreated ReplacementRequest[] @relation("ReplacementRequestCreatedBy")
    replacementRequestsUpdated ReplacementRequest[] @relation("ReplacementRequestUpdatedBy")
    replacementHistories ReplacementHistory[]
}

model Lead {
  id               String    @id @default(uuid()) @db.Uuid
  leadDate         DateTime
  adviserName      String    @db.VarChar(120)
  cmpt             String    @db.VarChar(80)
  customerPhone    String    @db.VarChar(30)
  customerName     String    @db.VarChar(160)
  customerEmail    String?   @db.VarChar(160)
  state            String?   @db.VarChar(80)
  partDescription  String    @db.VarChar(255)
  vehicleYear      String?   @db.VarChar(10)
  vehicleMake      String?   @db.VarChar(80)
  vehicleModel     String?   @db.VarChar(80)
  vehicleVariant   String?   @db.VarChar(80)
  quote            Decimal?  @db.Decimal(12, 2)
  quoteCurrency    String    @default("USD") @db.VarChar(3)
  comments         String?   @db.Text
  prospects        String    @db.VarChar(255)
  status           LeadStatus @default(PROSPECT)
  createdById      String    @db.Uuid
  convertedOrderId String?   @unique @db.Uuid
  convertedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  createdBy      User   @relation(fields: [createdById], references: [id], onDelete: Restrict)
  convertedOrder Order? @relation("ConvertedLeadOrder", fields: [convertedOrderId], references: [id], onDelete: SetNull)

  @@index([leadDate])
  @@index([createdById])
  @@index([status])
  @@index([convertedAt])
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  orderNumber     String      @unique @db.VarChar(50)
  salesNumber     String?     @db.VarChar(80)
  customerName    String      @db.VarChar(160)
  partDescription String      @db.VarChar(255)
  customerEmail   String?     @db.VarChar(160)
  customerPhone   String?     @db.VarChar(30)
  intakeDetails   Json?
  price           Decimal     @db.Decimal(12, 2)
  quantity        Int
  totalSaleAmount Decimal     @db.Decimal(12, 2)
  currency        String      @default("USD") @db.VarChar(3)
  status          OrderStatus @default(DRAFT)
  paymentMethod   OrderPaymentMethod?
  createdById     String      @db.Uuid
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  createdBy User       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  sourceLead Lead?     @relation("ConvertedLeadOrder")
  shipments Shipment[]
  notes     Note[]
  invoice   Invoice?
  replacementRequests ReplacementRequest[]

  @@index([orderNumber])
  @@index([createdById])
}

model Invoice {
  id                     String    @id @default(uuid()) @db.Uuid
  orderId                String    @unique @db.Uuid
  invoiceNumber          String    @unique @db.VarChar(50)
  invoiceDate            DateTime
  salesAssistant         String?   @db.VarChar(120)
  customerName           String    @db.VarChar(160)
  contactNumber          String?   @db.VarChar(30)
  billingAddress         String?   @db.Text
  shippingAddress        String?   @db.Text
  shippingVendor         String    @default("LTL") @db.VarChar(80)
  deliveryTimeline       String    @default("7-8 Business Days") @db.VarChar(120)
  itemDescription        String    @db.VarChar(255)
  vehiclePartDescription String?   @db.VarChar(255)
  warrantyPartsOnly      String?   @db.Text
  cancellationPolicy     String?   @db.Text
  quantity               Int
  saleAmount             Decimal   @db.Decimal(12, 2)
  paymentStatus          String?   @db.VarChar(80)
  paymentDate            DateTime?
  paymentSource          String?   @db.VarChar(160)
  shippingCost           Decimal   @default(0) @db.Decimal(12, 2)
  salesTaxes             Decimal   @default(0) @db.Decimal(12, 2)
  coreCharge             Decimal   @default(0) @db.Decimal(12, 2)
  totalAmount            Decimal   @db.Decimal(12, 2)
  customerSignature      String?   @db.Text
  customerSignatureImage String?   @db.Text
  signatureDate          DateTime?
  photoIdRequired        Boolean   @default(false)
  photoIdDocument        String?   @db.Text
  photoIdFileName        String?   @db.VarChar(255)
  photoIdMimeType        String?   @db.VarChar(80)
  photoIdUploadedAt      DateTime?
  signedAt               DateTime?
  signatureIpAddress     String?   @db.VarChar(64)
  signatureTokenHash     String?   @unique @db.VarChar(128)
  signatureTokenExpiresAt DateTime?
  signatureRequestedAt   DateTime?
  signatureLastSentAt    DateTime?
  status                 String    @default("CREATED") @db.VarChar(40)
  pdfStorageKey          String?   @db.VarChar(255)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  auditEvents InvoiceAuditEvent[]

  @@index([invoiceNumber])
  @@index([createdAt])
  @@index([signatureTokenExpiresAt])
}

model InvoiceAuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @db.Uuid
  eventType   String   @db.VarChar(40)
  title       String   @db.VarChar(80)
  description String   @db.Text
  actorName   String?  @db.VarChar(160)
  actorEmail  String?  @db.VarChar(160)
  actorPhone  String?  @db.VarChar(40)
  ipAddress   String?  @db.VarChar(64)
  metadata    Json?
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, occurredAt])
  @@index([eventType])
}

model Shipment {
  id          String         @id @default(uuid()) @db.Uuid
  bolNumber   String?        @unique @db.VarChar(50)
  pickupNumber String?        @db.VarChar(50)
  proNumber   String?        @unique @db.VarChar(50)
  carrierName String?        @db.VarChar(120)
  status      ShipmentStatus @default(PENDING)
  orderId     String         @db.Uuid
  shippedAt   DateTime?
  deliveredAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

    order   Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
    costs   ShipmentCost[]
    additionalCosts ShipmentAdditionalCost[]
    costHistories ShipmentCostHistory[]
    events  ShipmentEvent[]
    notes   Note[]
    replacementRequests ReplacementRequest[]

  @@index([bolNumber])
  @@index([pickupNumber])
  @@index([proNumber])
  @@index([orderId])
}

model ReplacementRequest {
  id                String            @id @default(uuid()) @db.Uuid
  orderId           String            @db.Uuid
  shipmentId        String?           @db.Uuid
  customerReason    String            @db.Text
  yardUpdate        String?           @db.Text
  replacementStatus ReplacementStatus @default(YARD_CONTACTED)
  replacementProNumber String?         @db.VarChar(50)
  replacementCarrierName String?       @db.VarChar(120)
  createdById       String            @db.Uuid
  updatedById       String?           @db.Uuid
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shipment  Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  createdBy User      @relation("ReplacementRequestCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User?     @relation("ReplacementRequestUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  histories ReplacementHistory[]

  @@index([orderId])
  @@index([shipmentId])
  @@index([replacementStatus])
  @@index([replacementProNumber])
  @@index([updatedAt])
  @@index([createdAt])
}

model ReplacementHistory {
  id                   String   @id @default(uuid()) @db.Uuid
  replacementRequestId String   @db.Uuid
  action               String   @db.VarChar(80)
  summary              String   @db.Text
  previousStatus       ReplacementStatus?
  nextStatus           ReplacementStatus?
  customerReason       String?  @db.Text
  yardUpdate           String?  @db.Text
  replacementProNumber String?  @db.VarChar(50)
  replacementCarrierName String? @db.VarChar(120)
  createdById          String   @db.Uuid
  createdAt            DateTime @default(now())

  replacementRequest ReplacementRequest @relation(fields: [replacementRequestId], references: [id], onDelete: Cascade)
  createdBy          User               @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([replacementRequestId])
  @@index([createdById])
  @@index([createdAt])
}

  model ShipmentCost {
  id               String   @id @default(uuid()) @db.Uuid
  shipmentId       String   @unique @db.Uuid
  purchaseAmount   Decimal  @db.Decimal(12, 2)
  shippingAmount   Decimal  @default(0) @db.Decimal(12, 2)
  additionalAmount Decimal  @default(0) @db.Decimal(12, 2)
  grossProfit      Decimal  @db.Decimal(12, 2)
  currency         String   @default("USD") @db.VarChar(10)
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

    @@index([shipmentId])
  }

  model ShipmentAdditionalCost {
    id          String   @id @default(uuid()) @db.Uuid
    shipmentId  String   @db.Uuid
    amount      Decimal  @db.Decimal(12, 2)
    reason      String   @db.Text
    createdById String   @db.Uuid
    createdAt   DateTime @default(now())

    shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
    createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

    @@index([shipmentId])
    @@index([createdById])
    @@index([createdAt])
  }

  model ShipmentCostHistory {
    id          String   @id @default(uuid()) @db.Uuid
    shipmentId  String   @db.Uuid
    action      String   @db.VarChar(80)
    summary     String   @db.Text
    changes     Json?
    createdById String   @db.Uuid
    createdAt   DateTime @default(now())

    shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
    createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

    @@index([shipmentId])
    @@index([createdById])
    @@index([createdAt])
  }

model ShipmentEvent {
  id          String   @id @default(uuid()) @db.Uuid
  shipmentId  String   @db.Uuid
  eventType   String   @db.VarChar(80)
  description String?  @db.Text
  location    String?  @db.VarChar(160)
  eventAt     DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  @@index([shipmentId])
  @@index([eventAt])
}

model Note {
  id         String         @id @default(uuid()) @db.Uuid
  content    String         @db.Text
  entityType NoteEntityType
  authorId   String         @db.Uuid
  orderId    String?        @db.Uuid
  shipmentId String?        @db.Uuid
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  author   User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  order    Order?    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  @@index([authorId])
  @@index([orderId])
  @@index([shipmentId])
  @@index([entityType, orderId])
  @@index([entityType, shipmentId])
}

model Notification {
  id              String    @id @default(uuid()) @db.Uuid
  recipientUserId String    @db.Uuid
  type            String    @db.VarChar(80)
  title           String    @db.VarChar(160)
  message         String    @db.Text
  entityType      String    @db.VarChar(40)
  entityId        String    @db.Uuid
  isRead          Boolean   @default(false)
  readAt          DateTime?
  clearedAt       DateTime?
  createdAt       DateTime  @default(now())

  recipient User @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, clearedAt, createdAt])
  @@index([recipientUserId, isRead, clearedAt])
  @@index([entityType, entityId])
}
